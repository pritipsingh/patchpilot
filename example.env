# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------
OPENAI_API_KEY=sk-***

# ---------------------------------------------------------------------------
# GitHub identity -- pick ONE. This decides who authors the pull requests.
#
# A) GitHub App (recommended). PRs are authored by the app, e.g. "PR Agent[bot]".
#    No org seat, per-repo installation control, and tokens are minted on demand
#    and expire in an hour. Create the app at
#    https://github.com/organizations/<org>/settings/apps with repository
#    permissions: Contents read+write, Pull requests read+write, Metadata read.
#    Then install it on agno-os and agno, and download a private key.
#    The PEM can be inline (escaped newlines are fine) or a path to the .pem file.
# GITHUB_APP_ID=123456
# GITHUB_APP_PRIVATE_KEY=/secrets/pr-agent.private-key.pem
# Optional: pin one installation instead of resolving it per repository.
# GITHUB_APP_INSTALLATION_ID=
#
# B) A token. PRs are authored by whoever owns it. Use a fine-grained token scoped
#    to the repos in GITHUB_REPOS, with the same three permissions. A private repo
#    (agno-agi/agno-os) must be selected in the token's repository access list, and
#    its owner must already have access.
GITHUB_ACCESS_TOKEN=github_pat_***

# ---------------------------------------------------------------------------
# Slack -- set both to put the agent in your workspace.
#   SLACK_BOT_TOKEN       Bot User OAuth Token (xoxb-***)
#   SLACK_SIGNING_SECRET  Basic Information -> App Credentials -> Signing Secret
# ---------------------------------------------------------------------------
SLACK_BOT_TOKEN=xoxb-***
SLACK_SIGNING_SECRET=***

# ---------------------------------------------------------------------------
# Guardrails
# ---------------------------------------------------------------------------
# Comma-separated allowlist. The agent refuses every repo not on this list.
# agno-os is private: the token below has to be granted access to it explicitly.
GITHUB_REPOS=agno-agi/agno-os,agno-agi/agno

# Every branch the agent pushes starts with this. It cannot write anywhere else.
# PR_BRANCH_PREFIX=pr-agent/

# Open pull requests as drafts unless asked otherwise.
# PR_DRAFT_BY_DEFAULT=True

# Ask in Slack (approve / deny buttons) before any write reaches GitHub.
# Turning this off lets the agent open PRs and post comments unattended.
# REQUIRE_CONFIRMATION=True

# ---------------------------------------------------------------------------
# Workspace -- where bare mirrors and per-session worktrees live.
# On a container this must be a persistent volume, or every cold start
# re-clones every repository.
# ---------------------------------------------------------------------------
# WORKSPACE_ROOT=~/.agno-pr-agent
# WORKSPACE_MAX_AGE_HOURS=12

# Programs the agent's shell may run, comma-separated. Anything not listed is
# refused, including inside `bash -c`. Add the repo's test runner here.
# The agent's shell gets no credentials and no git.
# SHELL_ALLOWED_COMMANDS=python,python3,pytest,ruff,mypy,ls,cat,grep,bash,sh

# ---------------------------------------------------------------------------
# Model
# ---------------------------------------------------------------------------
# MODEL_ID=gpt-5.6

# ---------------------------------------------------------------------------
# Runtime
#   RUNTIME_ENV=dev serves without auth. Anything else requires a JWT
#   verification key -- generate one at os.agno.com.
# ---------------------------------------------------------------------------
# RUNTIME_ENV=dev
# JWT_VERIFICATION_KEY=
# AGNO_DEBUG=False

# ---------------------------------------------------------------------------
# Database -- SQLite (pr_agent.db) when nothing here is set.
#   DATABASE_URL is what Railway, Neon and Supabase hand you.
# ---------------------------------------------------------------------------
# DATABASE_URL=postgresql://user:pass@host:5432/db
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=ai
# DB_PASS=ai
# DB_DATABASE=ai

# Clone the allowlisted repos in the background at startup, so the first
# message does not pay for a cold clone.
# PREWARM_REPOS=True

# Stream replies token by token. Needs the Slack app to be configured as an
# agent (assistant_view in the manifest + the assistant_thread_started event);
# without that, Slack's chat.startStream returns team_not_found and no reply
# is ever posted. Leave off unless the app is set up that way.
# SLACK_STREAMING=False
# Optional AgntID runtime enforcement (install with: uv pip install -e '.[agntid]').
# Disabled leaves the existing local tools unchanged. Enabled never falls back.
AGNTID_ENABLED=false
AGNTID_MCP_URL=http://localhost:8082/mcp
# Exact public MCP prefix returned by the runtime, often pr_agent_.
AGNTID_TOOL_PREFIX=pr_agent_
AGNTID_ACCESS_TOKEN=
AGNTID_CALL_TIMEOUT=300
# Callback listener; connect AgntID to http://host.docker.internal:8091/mcp.
# Bind to a private reachable interface if the runtime cannot reach loopback.
AGNTID_EXECUTOR_HOST=127.0.0.1
AGNTID_EXECUTOR_PORT=8091
